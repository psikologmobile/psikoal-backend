@page "/matches"
@inject IAdminClientService AdminClient

<PageTitle>Eşleşmeler — Psikosirius Admin</PageTitle>

<PageHeader Title="Eşleşmeler"
            Description="Eşleşme normalde iki tarafın onayıyla sonlanır; ihtilafta admin tek taraflı müdahale edebilir." />

<div class="toolbar">
    <Select Class="toolbar-select" @bind-Value="_status">
        <option value="ACTIVE">Aktif</option>
        <option value="COMPLETED">Tamamlandı</option>
        <option value="RELEASED">Sonlandırıldı</option>
        <option value="">Tümü</option>
    </Select>
    <Button Disabled="_isLoading" OnClick="LoadAsync">Filtrele</Button>
</div>

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

<Card Class="table-card">
    @if (_isLoading)
    {
        <LoadingSkeleton />
    }
    else if (_matches is { Count: 0 })
    {
        <EmptyState Title="Eşleşme bulunamadı" Description="Seçtiğiniz durumda eşleşme yok." />
    }
    else if (_matches is not null)
    {
        <Table>
            <TableHeader>
                <TableRow>
                    <TableHead>Danışan</TableHead>
                    <TableHead>Uzman</TableHead>
                    <TableHead>İlan</TableHead>
                    <TableHead>Durum</TableHead>
                    <TableHead>Onay Durumu</TableHead>
                    <TableHead>Kayıt</TableHead>
                    <TableHead Class="text-right">İşlem</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var match in _matches)
                {
                    <TableRow>
                        <TableCell>@match.ClientFullName</TableCell>
                        <TableCell>@match.ExpertFullName</TableCell>
                        <TableCell Class="max-w-xs">@match.ListingTitle</TableCell>
                        <TableCell><StatusChip Status="@match.Status" /></TableCell>
                        <TableCell Class="text-muted-foreground text-xs">
                            @(match.ClientReleasedAt is not null ? "Danışan onayladı" : "Danışan bekliyor") /
                            @(match.ExpertReleasedAt is not null ? "Uzman onayladı" : "Uzman bekliyor")
                        </TableCell>
                        <TableCell Class="text-muted-foreground">@match.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</TableCell>
                        <TableCell Class="cell-actions">
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                    OnClick="() => ToggleDetailAsync(match.Id)">
                                @(_openMatchId == match.Id ? "Kapat" : "İncele")
                            </Button>
                        </TableCell>
                    </TableRow>

                    @if (_openMatchId == match.Id && _detail is not null)
                    {
                        <TableRow>
                            <TableCell Class="detail-cell" colspan="7">
                                <div class="detail-panel">
                                    <dl class="detail-list">
                                        <dt>Danışan E-posta</dt>
                                        <dd>@_detail.ClientEmail</dd>
                                        <dt>Teklif Fiyatı</dt>
                                        <dd>₺@_detail.OfferPrice.ToString("N0")</dd>
                                        @if (_detail.ReleasedByAdmin)
                                        {
                                            <dt>Admin Müdahalesi</dt>
                                            <dd>@_detail.ReleaseReason</dd>
                                        }
                                    </dl>

                                    @if (_detail.Status == MatchTargetStatusActive)
                                    {
                                        <div class="detail-actions">
                                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                                    OnClick="() => AskForceRelease(match.Id, MatchTargetStatusReleased)">
                                                Zorla Sonlandır
                                            </Button>
                                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                                    OnClick="() => AskForceRelease(match.Id, MatchTargetStatusCompleted)">
                                                Zorla Tamamla
                                            </Button>
                                        </div>
                                    }
                                </div>
                            </TableCell>
                        </TableRow>
                    }
                }
            </TableBody>
        </Table>
    }
</Card>

<ReasonDialog Open="_isForceDialogOpen"
              OpenChanged="value => _isForceDialogOpen = value"
              Title="Eşleşmeye müdahale et"
              Description="Tek taraflı sonlandırma audit log'a yazılır ve geri alınamaz."
              ReasonLabel="Sebep"
              Placeholder="İhtilafın gerekçesini yazın..."
              ConfirmLabel="Uygula"
              OnConfirm="ForceReleaseConfirmedAsync" />

@code {
    private const string MatchTargetStatusActive = "ACTIVE";
    private const string MatchTargetStatusReleased = "RELEASED";
    private const string MatchTargetStatusCompleted = "COMPLETED";

    private IReadOnlyList<AdminMatchListItemDto>? _matches;
    private AdminMatchDetailDto? _detail;
    private Guid? _openMatchId;
    private string _status = "ACTIVE";
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _isForceDialogOpen;
    private Guid? _pendingMatchId;
    private string? _pendingTargetStatus;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _openMatchId = null;
        try
        {
            var result = await AdminClient.ListMatchesAsync(_status, CancellationToken.None);
            _matches = result.Value;
            _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleDetailAsync(Guid matchId)
    {
        if (_openMatchId == matchId)
        {
            _openMatchId = null;
            _detail = null;
            return;
        }

        _openMatchId = matchId;
        var detailResult = await AdminClient.GetMatchDetailAsync(matchId, CancellationToken.None);
        _detail = detailResult.Value;
        _errorMessage = detailResult.ErrorMessage;
    }

    private void AskForceRelease(Guid matchId, string targetStatus)
    {
        _pendingMatchId = matchId;
        _pendingTargetStatus = targetStatus;
        _isForceDialogOpen = true;
    }

    private async Task ForceReleaseConfirmedAsync(string reason)
    {
        if (_pendingMatchId is not { } matchId || _pendingTargetStatus is not { } targetStatus)
        {
            return;
        }

        _pendingMatchId = null;
        _pendingTargetStatus = null;

        var result = await AdminClient.ForceReleaseMatchAsync(matchId, targetStatus, reason, CancellationToken.None);
        _errorMessage = result.ErrorMessage;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }
}
