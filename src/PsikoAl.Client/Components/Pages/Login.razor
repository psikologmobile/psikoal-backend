@page "/login"
@layout PsikoAl.Client.Components.Layout.BareLayout
@inject IAdminAuthService Auth
@inject AdminSessionState Session
@inject NavigationManager Navigation

<PageTitle>Giriş — Psikosirius Admin</PageTitle>

<div class="auth-shell" data-testid="screen-login">
    <Card Class="auth-card">
        <CardHeader>
            <span class="auth-brand">Psikosirius Admin</span>
            <CardTitle>Yönetim Paneli</CardTitle>
            <CardDescription>Devam etmek için hesabınızla giriş yapın.</CardDescription>
        </CardHeader>
        <CardContent Class="space-y-4">
            <div class="field">
                <Label For="email">E-posta</Label>
                <Input id="email" data-testid="login-email" Type="email" @bind-Value="_email" Placeholder="ornek@psikoal.com" />
            </div>

            <div class="field">
                <Label For="password">Şifre</Label>
                <Input id="password" data-testid="login-password" Type="password" @bind-Value="_password" />
            </div>

            @if (_errorMessage is not null)
            {
                <Alert Variant="AlertVariant.Destructive">
                    <AlertDescription data-testid="login-error">@_errorMessage</AlertDescription>
                </Alert>
            }
        </CardContent>
        <CardFooter>
            <Button Class="w-full" data-testid="login-submit" Disabled="_isBusy" IsLoading="_isBusy" OnClick="SubmitAsync">
                @(_isBusy ? "Giriş yapılıyor..." : "Giriş Yap")
            </Button>
        </CardFooter>
    </Card>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private bool _isBusy;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Auth.RestoreAsync(CancellationToken.None);
        if (Session.IsAuthenticated)
        {
            Navigation.NavigateTo(SafeReturnUrl());
        }
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            var result = await Auth.LoginAsync(_email, _password, CancellationToken.None);
            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage;
                return;
            }

            _password = string.Empty;
            Navigation.NavigateTo(SafeReturnUrl());
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string SafeReturnUrl()
        => ReturnUrl is { Length: > 0 } url
           && url.StartsWith('/')
           && !url.StartsWith("//", StringComparison.Ordinal)
           && !url.StartsWith("/\\", StringComparison.Ordinal)
           && !url.StartsWith("/login", StringComparison.OrdinalIgnoreCase)
            ? url
            : "/";
}
