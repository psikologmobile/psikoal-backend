@page "/experts"
@inject IAdminClientService AdminClient
@inject AdminSessionState Session

<PageTitle>Uzmanlar — PsikoAl Admin</PageTitle>

<PageHeader Title="Uzman Onayları"
            Description="Onaylanmayan uzman profili yayına çıkmaz ve teklif gönderemez. Onay ile doğrulama rozeti ayrı alanlardır." />

<div class="toolbar">
    <Select Class="toolbar-select" @bind-Value="_status">
        <option value="">Tümü</option>
        <option value="pending">Onay Bekleyen</option>
        <option value="revision_pending">Revizyon Bekleyen</option>
        <option value="approved">Onaylı</option>
        <option value="rejected">Reddedilmiş</option>
    </Select>
    <Button Disabled="_isLoading" OnClick="LoadAsync">Filtrele</Button>
</div>

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

<Card Class="table-card">
    @if (_isLoading)
    {
        <LoadingSkeleton />
    }
    else if (_experts is { Count: 0 })
    {
        <EmptyState Title="Uzman bulunamadı" Description="Seçtiğiniz durumda uzman kaydı yok." />
    }
    else if (_experts is not null)
    {
        <Table>
            <TableHeader>
                <TableRow>
                    <TableHead>Ad Soyad</TableHead>
                    <TableHead>Ünvan</TableHead>
                    <TableHead>Durum</TableHead>
                    <TableHead>Rozet</TableHead>
                    <TableHead>Kayıt</TableHead>
                    <TableHead Class="text-right">İşlem</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var expert in _experts)
                {
                    <TableRow>
                        <TableCell>
                            @expert.FullName
                            <div class="muted">@expert.Email</div>
                        </TableCell>
                        <TableCell>@expert.Title</TableCell>
                        <TableCell>
                            <StatusChip Status="@expert.Status" />
                            @if (expert.HasPendingRevision)
                            {
                                <StatusChip Status="pending" Label="Revizyon" />
                            }
                        </TableCell>
                        <TableCell>
                            @if (expert.IsVerified)
                            {
                                <StatusChip Status="approved" Label="Doğrulanmış" />
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </TableCell>
                        <TableCell Class="text-muted-foreground">@expert.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</TableCell>
                        <TableCell Class="cell-actions">
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                    OnClick="() => ToggleDetailAsync(expert.Id)">
                                @(_openExpertId == expert.Id ? "Kapat" : "İncele")
                            </Button>
                        </TableCell>
                    </TableRow>

                    @if (_openExpertId == expert.Id && _detail is not null)
                    {
                        <TableRow>
                            <TableCell Class="detail-cell" colspan="6">
                                <div class="detail-panel">
                                    <Tabs DefaultValue="profile">
                                        <TabsList>
                                            <TabsTrigger Value="profile">Profil</TabsTrigger>
                                            <TabsTrigger Value="documents">Belgeler</TabsTrigger>
                                            @if (CanManageWallet)
                                            {
                                                <TabsTrigger Value="wallet">Cüzdan</TabsTrigger>
                                            }
                                        </TabsList>

                                        <TabsContent Value="profile">
                                            <div class="detail-columns">
                                                <div>
                                                    <h3 class="detail-heading">Yayındaki Profil</h3>
                                                    <dl class="detail-list">
                                                        <dt>Ünvan</dt>
                                                        <dd>@_detail.Current.Title</dd>
                                                        <dt>Uzmanlıklar</dt>
                                                        <dd>@string.Join(", ", _detail.Current.Specializations)</dd>
                                                        <dt>Deneyim</dt>
                                                        <dd>@_detail.Current.ExperienceYears yıl</dd>
                                                        <dt>Biyografi</dt>
                                                        <dd>@_detail.Current.Bio</dd>
                                                        <dt>Eğitim</dt>
                                                        <dd>@(_detail.Current.Education ?? "—")</dd>
                                                        <dt>Web sitesi</dt>
                                                        <dd>@(_detail.Current.PersonalWebsite ?? "—")</dd>
                                                    </dl>
                                                </div>
                                                @if (_detail.PendingRevision is not null)
                                                {
                                                    <div>
                                                        <h3 class="detail-heading detail-heading-warning">Bekleyen Revizyon</h3>
                                                        <dl class="detail-list">
                                                            <dt>Ünvan</dt>
                                                            <dd>@Changed(_detail.PendingRevision.Title, _detail.Current.Title)</dd>
                                                            <dt>Uzmanlıklar</dt>
                                                            <dd>@Changed(_detail.PendingRevision.Specializations is null ? null : string.Join(", ", _detail.PendingRevision.Specializations), string.Join(", ", _detail.Current.Specializations))</dd>
                                                            <dt>Deneyim</dt>
                                                            <dd>@Changed(_detail.PendingRevision.ExperienceYears?.ToString(), _detail.Current.ExperienceYears.ToString())</dd>
                                                            <dt>Biyografi</dt>
                                                            <dd>@Changed(_detail.PendingRevision.Bio, _detail.Current.Bio)</dd>
                                                            <dt>Eğitim</dt>
                                                            <dd>@Changed(_detail.PendingRevision.Education, _detail.Current.Education)</dd>
                                                            <dt>Web sitesi</dt>
                                                            <dd>@Changed(_detail.PendingRevision.PersonalWebsite, _detail.Current.PersonalWebsite)</dd>
                                                        </dl>
                                                    </div>
                                                }
                                            </div>
                                        </TabsContent>

                                        <TabsContent Value="documents">
                                            <div class="detail-documents">
                                                @if (_documents?.CvUrl is not null)
                                                {
                                                    <a class="link-button" href="@_documents.CvUrl" target="_blank" rel="noopener noreferrer">CV'yi Görüntüle</a>
                                                }
                                                @if (_documents is not null)
                                                {
                                                    @foreach (var (url, index) in _documents.CertificateUrls.Select((url, index) => (url, index)))
                                                    {
                                                        <a class="link-button" href="@url" target="_blank" rel="noopener noreferrer">Sertifika @(index + 1)</a>
                                                    }
                                                }
                                                @if (_documents is null || (_documents.CvUrl is null && _documents.CertificateUrls.Count == 0))
                                                {
                                                    <span class="muted">Yüklü belge yok.</span>
                                                }
                                            </div>
                                        </TabsContent>
                                        @if (CanManageWallet)
                                        {
                                            <TabsContent Value="wallet">
                                                <ExpertWalletPanel ExpertId="expert.Id" />
                                            </TabsContent>
                                        }
                                    </Tabs>

                                    @if (_detail.RejectionReason is not null)
                                    {
                                        <Alert Variant="AlertVariant.Destructive">
                                            <AlertDescription>Son red sebebi: @_detail.RejectionReason</AlertDescription>
                                        </Alert>
                                    }

                                    <div class="detail-actions">
                                        <Button Size="ButtonSize.Sm" OnClick="() => ApproveAsync(expert.Id)">Onayla</Button>
                                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                                OnClick="() => AskReject(expert.Id)">
                                            Reddet
                                        </Button>
                                        <div class="switch-field">
                                            <Switch Checked="expert.IsVerified"
                                                    CheckedChanged="value => ToggleVerifiedAsync(expert.Id, value)" />
                                            <span>Doğrulama rozeti</span>
                                        </div>
                                    </div>
                                </div>
                            </TableCell>
                        </TableRow>
                    }
                }
            </TableBody>
        </Table>
    }
</Card>

<ReasonDialog Open="_isRejectDialogOpen"
              OpenChanged="value => _isRejectDialogOpen = value"
              Title="Uzman profilini reddet"
              Description="Red sebebi uzmana bildirilir; eksiklerini giderip yeniden başvurabilir."
              ReasonLabel="Red sebebi"
              Placeholder="Eksik belge, doğrulanamayan lisans..."
              ConfirmLabel="Reddet"
              OnConfirm="RejectConfirmedAsync" />

@code {
    private IReadOnlyList<AdminExpertListItemDto>? _experts;
    private AdminExpertDetailDto? _detail;
    private AdminExpertDocumentUrls? _documents;
    private Guid? _openExpertId;
    private string _status = "pending";
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _isRejectDialogOpen;
    private Guid? _pendingRejectExpertId;

    // Cüzdan uçları finans politikasında: moderatör sekmeyi görmez (uç zaten 403 döner).
    private bool CanManageWallet => Session.CanAccess(AdminRoleGroups.Finance);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _openExpertId = null;
        try
        {
            var result = await AdminClient.ListExpertsAsync(_status, CancellationToken.None);
            _experts = result.Value;
            _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleDetailAsync(Guid expertId)
    {
        if (_openExpertId == expertId)
        {
            _openExpertId = null;
            _detail = null;
            _documents = null;
            return;
        }

        _openExpertId = expertId;
        var detailResult = await AdminClient.GetExpertDetailAsync(expertId, CancellationToken.None);
        _detail = detailResult.Value;
        _errorMessage = detailResult.ErrorMessage;
        var documentsResult = await AdminClient.GetExpertDocumentUrlsAsync(expertId, CancellationToken.None);
        _documents = documentsResult.Value;
        _errorMessage ??= documentsResult.ErrorMessage;
    }

    private async Task ApproveAsync(Guid expertId)
    {
        var result = await AdminClient.ApproveExpertAsync(expertId, CancellationToken.None);
        _errorMessage = result.ErrorMessage;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }

    private void AskReject(Guid expertId)
    {
        _pendingRejectExpertId = expertId;
        _isRejectDialogOpen = true;
    }

    private async Task RejectConfirmedAsync(string reason)
    {
        if (_pendingRejectExpertId is not { } expertId)
        {
            return;
        }

        _pendingRejectExpertId = null;

        var result = await AdminClient.RejectExpertAsync(expertId, reason, CancellationToken.None);
        _errorMessage = result.ErrorMessage;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }

    private async Task ToggleVerifiedAsync(Guid expertId, bool isVerified)
    {
        var result = await AdminClient.SetExpertVerifiedAsync(expertId, isVerified, CancellationToken.None);
        _errorMessage = result.ErrorMessage;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }

    private static string Changed(string? revisionValue, string? currentValue)
        => revisionValue is null || revisionValue == currentValue ? "—" : revisionValue;
}
