@page "/users"
@inject IAdminClientService AdminClient

<PageTitle>Kullanıcılar — Psikosirius Admin</PageTitle>

<PageHeader Title="Kullanıcılar" Description="Tüm hesapları görüntüleyin, dondurun veya yeniden aktifleştirin." />

<div class="toolbar">
    <Input Class="toolbar-search" Placeholder="E-posta veya isim ara..." @bind-Value="_search" />
    <Select Class="toolbar-select" @bind-Value="_role">
        <option value="">Tüm roller</option>
        <option value="expert">Uzman</option>
        <option value="client">Danışan</option>
    </Select>
    <Select Class="toolbar-select" @bind-Value="_status">
        <option value="">Tüm durumlar</option>
        <option value="active">Aktif</option>
        <option value="frozen">Dondurulmuş</option>
        <option value="deleted">Silinmiş</option>
    </Select>
    <Button Disabled="_isLoading" OnClick="FilterAsync">Filtrele</Button>
</div>

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

<Card Class="table-card">
    @if (_isLoading)
    {
        <LoadingSkeleton />
    }
    else if (_users is { Count: 0 })
    {
        <EmptyState Title="Kayıt bulunamadı"
                    Description="Seçtiğiniz filtrelere uyan kullanıcı yok. Filtreleri değiştirip tekrar deneyin." />
    }
    else if (_users is not null)
    {
        <Table>
            <TableHeader>
                <TableRow>
                    <TableHead>E-posta</TableHead>
                    <TableHead>Ad Soyad</TableHead>
                    <TableHead>Rol</TableHead>
                    <TableHead>Durum</TableHead>
                    <TableHead>Kayıt</TableHead>
                    <TableHead Class="text-right">İşlem</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var user in _users)
                {
                    <TableRow>
                        <TableCell>@user.Email</TableCell>
                        <TableCell>@user.FullName</TableCell>
                        <TableCell><StatusChip Status="@user.Role" /></TableCell>
                        <TableCell><StatusChip Status="@user.Status" /></TableCell>
                        <TableCell Class="text-muted-foreground">@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</TableCell>
                        <TableCell Class="cell-actions">
                            <a class="link-button" data-testid="user-activity-link" href="@ActivityHref(user)">İşlem kaydı</a>
                            @if (user.Status == "active")
                            {
                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                        OnClick="() => AskFreeze(user.Id)">
                                    Dondur
                                </Button>
                            }
                            else if (user.Status == "frozen")
                            {
                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                        OnClick="() => UnfreezeAsync(user.Id)">
                                    Aktifleştir
                                </Button>
                            }
                        </TableCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
        <Pager Meta="_meta" Disabled="_isLoading" OnPageChanged="GoToPageAsync" />
    }
</Card>

<ConfirmDialog Open="_isFreezeDialogOpen"
               OpenChanged="value => _isFreezeDialogOpen = value"
               Title="Hesabı dondur"
               Description="Dondurulan kullanıcı uygulamaya giriş yapamaz. Bu işlem geri alınabilir."
               ConfirmLabel="Dondur"
               ConfirmVariant="ButtonVariant.Destructive"
               OnConfirm="FreezeConfirmedAsync" />

@code {
    private const int PerPage = 25;

    private IReadOnlyList<AdminUserListItemDto>? _users;
    private AdminPageMetaDto? _meta;
    private int _page = 1;
    private string _search = string.Empty;
    private string _role = string.Empty;
    private string _status = string.Empty;
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _isFreezeDialogOpen;
    private Guid? _pendingFreezeUserId;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task FilterAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var result = await AdminClient.ListUsersAsync(
                new AdminUserListQueryDto(_search, _role, _status, _page, PerPage),
                CancellationToken.None);
            _users = result.Value?.Data;
            _meta = result.Value?.Meta;
            _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string ActivityHref(AdminUserListItemDto user)
        => $"/activity?userId={user.Id}&name={Uri.EscapeDataString($"{user.FullName} · {user.Email}")}";

    private void AskFreeze(Guid userId)
    {
        _pendingFreezeUserId = userId;
        _isFreezeDialogOpen = true;
    }

    private async Task FreezeConfirmedAsync()
    {
        if (_pendingFreezeUserId is not { } userId)
        {
            return;
        }

        _isFreezeDialogOpen = false;
        _pendingFreezeUserId = null;

        var result = await AdminClient.FreezeUserAsync(userId, null, CancellationToken.None);
        _errorMessage = result.ErrorMessage;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }

    private async Task UnfreezeAsync(Guid userId)
    {
        var result = await AdminClient.UnfreezeUserAsync(userId, null, CancellationToken.None);
        _errorMessage = result.ErrorMessage;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }
}
