@page "/assessments"
@inject IAdminClientService AdminClient

<PageTitle>Testler — Psikosirius Admin</PageTitle>

<PageHeader Title="Psikolojik Testler"
            Description="Sorular yalnızca görüntülenir (düzenleme için migration gerekir). Başlık, açıklama, aktiflik ve puan bantlarının metinleri buradan düzenlenir." />

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

<Card Class="table-card">
    @if (_isLoading)
    {
        <LoadingSkeleton />
    }
    else if (_assessments is { Count: 0 })
    {
        <EmptyState Title="Test bulunamadı" Description="Henüz tanımlı bir psikolojik test yok." />
    }
    else if (_assessments is not null)
    {
        <Table>
            <TableHeader>
                <TableRow>
                    <TableHead>Sıra</TableHead>
                    <TableHead>Başlık</TableHead>
                    <TableHead>Kategori</TableHead>
                    <TableHead>Soru</TableHead>
                    <TableHead>Durum</TableHead>
                    <TableHead Class="text-right">İşlem</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var assessment in _assessments)
                {
                    <TableRow>
                        <TableCell>@assessment.SortOrder</TableCell>
                        <TableCell>@assessment.Title</TableCell>
                        <TableCell Class="text-muted-foreground">@assessment.Category</TableCell>
                        <TableCell Class="text-muted-foreground">@assessment.QuestionCount</TableCell>
                        <TableCell>
                            <StatusChip Status="@(assessment.IsActive ? "active" : "frozen")"
                                        Label="@(assessment.IsActive ? "Aktif" : "Pasif")" />
                        </TableCell>
                        <TableCell Class="cell-actions">
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                    OnClick="() => ToggleDetailAsync(assessment.Id)">
                                @(_openId == assessment.Id ? "Kapat" : "Düzenle")
                            </Button>
                        </TableCell>
                    </TableRow>

                    @if (_openId == assessment.Id && _detail is not null)
                    {
                        <TableRow>
                            <TableCell Class="detail-cell" colspan="6">
                                <div class="detail-panel">
                                    <section>
                                        <h3 class="detail-heading">Test Bilgisi</h3>
                                        <div class="stack-3">
                                            <div class="field">
                                                <Label>Başlık</Label>
                                                <Input @bind-Value="_editTitle" />
                                            </div>
                                            <div class="field">
                                                <Label>Açıklama</Label>
                                                <Textarea Rows="2" @bind-Value="_editDescription" />
                                            </div>
                                            <div class="form-grid">
                                                <div class="field">
                                                    <Label>Kategori</Label>
                                                    <Input @bind-Value="_editCategory" />
                                                </div>
                                                <div class="field">
                                                    <Label>Süre (dakika)</Label>
                                                    <Input Type="number" @bind-Value="_editMinutes" />
                                                </div>
                                                <div class="field">
                                                    <Label>Sıra</Label>
                                                    <Input Type="number" @bind-Value="_editSortOrder" />
                                                </div>
                                            </div>
                                            <div class="switch-field">
                                                <Switch @bind-Checked="_editActive" />
                                                <span>Yayında</span>
                                            </div>
                                            <div>
                                                <Button Size="ButtonSize.Sm" OnClick="() => SaveAssessmentAsync(assessment.Id)">
                                                    Kaydet
                                                </Button>
                                            </div>
                                        </div>
                                    </section>

                                    <Separator />

                                    <section>
                                        <h3 class="detail-heading">Puan Bantları</h3>
                                        <div class="stack-3">
                                            @foreach (var rule in _detail.ScoreRules)
                                            {
                                                <Card>
                                                    <CardContent Class="p-4 space-y-3">
                                                        <p class="muted">@rule.MinScore–@rule.MaxScore puan → @rule.Level</p>
                                                        <div class="field">
                                                            <Label>Sonuç özeti</Label>
                                                            <Textarea Rows="2"
                                                                      Value="@_ruleSummaryEdits.GetValueOrDefault(rule.Id, rule.Summary)"
                                                                      ValueChanged="value => _ruleSummaryEdits[rule.Id] = value" />
                                                        </div>
                                                        <div class="field">
                                                            <Label>Öneriler ( | ile ayırın)</Label>
                                                            <Input Value="@_ruleSuggestionsEdits.GetValueOrDefault(rule.Id, string.Join(" | ", rule.Suggestions))"
                                                                   ValueChanged="value => _ruleSuggestionsEdits[rule.Id] = value" />
                                                        </div>
                                                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                                                OnClick="() => SaveScoreRuleAsync(rule.Id)">
                                                            Bandı Kaydet
                                                        </Button>
                                                    </CardContent>
                                                </Card>
                                            }
                                        </div>
                                    </section>

                                    <Separator />

                                    <section>
                                        <h3 class="detail-heading">Sorular (@_detail.Questions.Count)</h3>
                                        <ol class="question-list">
                                            @foreach (var question in _detail.Questions)
                                            {
                                                <li>@question.Text</li>
                                            }
                                        </ol>
                                    </section>
                                </div>
                            </TableCell>
                        </TableRow>
                    }
                }
            </TableBody>
        </Table>
    }
</Card>

@code {
    private IReadOnlyList<AdminAssessmentListItemDto>? _assessments;
    private AdminAssessmentDetailDto? _detail;
    private Guid? _openId;
    private readonly Dictionary<Guid, string> _ruleSummaryEdits = [];
    private readonly Dictionary<Guid, string> _ruleSuggestionsEdits = [];

    private string _editTitle = string.Empty;
    private string _editDescription = string.Empty;
    private string _editCategory = string.Empty;
    private string _editMinutes = "3";
    private string _editSortOrder = "0";
    private bool _editActive;

    private bool _isLoading = true;
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var result = await AdminClient.ListAssessmentsAsync(CancellationToken.None);
            _assessments = result.Value;
            _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleDetailAsync(Guid assessmentId)
    {
        if (_openId == assessmentId)
        {
            _openId = null;
            _detail = null;
            return;
        }

        _openId = assessmentId;
        var result = await AdminClient.GetAssessmentDetailAsync(assessmentId, CancellationToken.None);
        _detail = result.Value;
        _errorMessage = result.ErrorMessage;
        if (_detail is not null)
        {
            _editTitle = _detail.Title;
            _editDescription = _detail.Description;
            _editCategory = _detail.Category;
            _editMinutes = _detail.EstimatedMinutes.ToString();
            _editSortOrder = _detail.SortOrder.ToString();
            _editActive = _detail.IsActive;
            _ruleSummaryEdits.Clear();
            _ruleSuggestionsEdits.Clear();
        }
    }

    private async Task SaveAssessmentAsync(Guid assessmentId)
    {
        if (!int.TryParse(_editMinutes, out var minutes) || !int.TryParse(_editSortOrder, out var sortOrder))
        {
            _errorMessage = "Süre ve sıra sayısal olmalıdır.";
            return;
        }

        var result = await AdminClient.UpdateAssessmentAsync(
            assessmentId,
            new UpdateAdminAssessmentDto(_editTitle, _editDescription, _editCategory, minutes, _editActive, sortOrder),
            CancellationToken.None);

        if (!result.Succeeded)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _openId = null;
        await LoadAsync();
    }

    private async Task SaveScoreRuleAsync(Guid ruleId)
    {
        if (_detail is null)
        {
            return;
        }

        var rule = _detail.ScoreRules.First(scoreRule => scoreRule.Id == ruleId);
        var summary = _ruleSummaryEdits.GetValueOrDefault(ruleId, rule.Summary);
        var suggestionsRaw = _ruleSuggestionsEdits.GetValueOrDefault(ruleId, string.Join(" | ", rule.Suggestions));
        var suggestions = suggestionsRaw.Split('|', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

        var result = await AdminClient.UpdateScoreRuleAsync(
            ruleId,
            new UpdateAdminScoreRuleDto(summary, suggestions),
            CancellationToken.None);

        if (!result.Succeeded)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        if (_openId is { } openId)
        {
            var refreshed = await AdminClient.GetAssessmentDetailAsync(openId, CancellationToken.None);
            _detail = refreshed.Value;
            _errorMessage = refreshed.ErrorMessage;
        }
    }
}
