@page "/notifications"
@using System.Text.Json
@inject IAdminClientService AdminClient

<PageTitle>Bildirimler — Psikosirius Admin</PageTitle>

<PageHeader Title="Bildirimler"
            Description="Şablon metinlerini düzenleyin veya bir segmente manuel duyuru gönderin." />

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

@if (_infoMessage is not null)
{
    <Alert Class="mb-4">
        <AlertDescription>@_infoMessage</AlertDescription>
    </Alert>
}

<Tabs DefaultValue="templates">
    <TabsList>
        <TabsTrigger Value="templates">Şablonlar</TabsTrigger>
        <TabsTrigger Value="send">Manuel Gönder</TabsTrigger>
        <TabsTrigger Value="history">Gönderim Geçmişi</TabsTrigger>
    </TabsList>

    <TabsContent Value="templates">
        <Card Class="table-card">
            @if (_isLoading)
            {
                <LoadingSkeleton />
            }
            else if (_templates is { Count: 0 })
            {
                <EmptyState Title="Şablon bulunamadı" Description="Bildirim şablonları henüz tanımlanmamış." />
            }
            else if (_templates is not null)
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Tip</TableHead>
                            <TableHead>Başlık</TableHead>
                            <TableHead>Kanallar</TableHead>
                            <TableHead>Durum</TableHead>
                            <TableHead Class="text-right">İşlem</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var template in _templates)
                        {
                            <TableRow>
                                <TableCell Class="text-muted-foreground font-mono text-xs">@template.Type</TableCell>
                                <TableCell>@template.Title</TableCell>
                                <TableCell Class="text-muted-foreground text-xs">@ChannelLabel(template)</TableCell>
                                <TableCell>
                                    <StatusChip Status="@(template.IsActive ? "active" : "frozen")"
                                                Label="@(template.IsActive ? "Aktif" : "Pasif")" />
                                </TableCell>
                                <TableCell Class="cell-actions">
                                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                            OnClick="() => ToggleEdit(template)">
                                        @(_editingType == template.Type ? "Kapat" : "Düzenle")
                                    </Button>
                                </TableCell>
                            </TableRow>

                            @if (_editingType == template.Type)
                            {
                                <TableRow>
                                    <TableCell Class="detail-cell" colspan="5">
                                        <div class="stack-3">
                                            <div class="field">
                                                <Label>Başlık</Label>
                                                <Input @bind-Value="_editTitle" />
                                            </div>
                                            <div class="field">
                                                <Label>Gövde — {değişken} yer tutucuları kullanılabilir</Label>
                                                <Textarea Rows="3" @bind-Value="_editBody" />
                                            </div>
                                            <div class="field">
                                                <Label>HTML gövde (e-posta) — boş bırakılırsa gövde otomatik sarmalanır</Label>
                                                <Textarea Rows="3" Value="@(_editHtmlBody ?? string.Empty)"
                                                          ValueChanged="value => _editHtmlBody = value" />
                                            </div>
                                            <div class="detail-actions">
                                                <div class="switch-field">
                                                    <Switch @bind-Checked="_editInApp" /><span>In-app</span>
                                                </div>
                                                <div class="switch-field">
                                                    <Switch @bind-Checked="_editPush" /><span>Push</span>
                                                </div>
                                                <div class="switch-field">
                                                    <Switch @bind-Checked="_editEmail" /><span>E-posta</span>
                                                </div>
                                                <div class="switch-field">
                                                    <Switch @bind-Checked="_editActive" /><span>Aktif</span>
                                                </div>
                                                <Button Size="ButtonSize.Sm" OnClick="() => SaveTemplateAsync(template.Type)">
                                                    Kaydet
                                                </Button>
                                            </div>
                                        </div>
                                    </TableCell>
                                </TableRow>
                            }
                        }
                    </TableBody>
                </Table>
            }
        </Card>
    </TabsContent>

    <TabsContent Value="send">
        <Card>
            <CardHeader>
                <CardTitle>Manuel Bildirim</CardTitle>
                <CardDescription>Tek bir kullanıcıya veya bir segmente SYSTEM tipinde duyuru gönderir.</CardDescription>
            </CardHeader>
            <CardContent Class="space-y-4">
                <div class="form-grid">
                    <div class="field">
                        <Label>Hedef</Label>
                        <Select @bind-Value="_targetType">
                            <option value="segment">Segment</option>
                            <option value="user">Tek Kullanıcı</option>
                        </Select>
                    </div>

                    @if (_targetType == TargetTypeSegment)
                    {
                        <div class="field">
                            <Label>Rol</Label>
                            <Select @bind-Value="_segmentRole">
                                <option value="client">Tüm Danışanlar</option>
                                <option value="expert">Tüm Uzmanlar</option>
                            </Select>
                        </div>
                        <div class="field">
                            <Label>Şehir (opsiyonel)</Label>
                            <Input Placeholder="İstanbul" @bind-Value="_segmentCity" />
                        </div>
                    }
                    else
                    {
                        <div class="field">
                            <Label>Kullanıcı ID</Label>
                            <Input Placeholder="uuid" @bind-Value="_targetUserId" />
                        </div>
                    }
                </div>

                <div class="field">
                    <Label>Başlık</Label>
                    <Input data-testid="notification-title" @bind-Value="_sendTitle" />
                </div>
                <div class="field">
                    <Label>Mesaj</Label>
                    <div data-testid="notification-body"><Textarea Rows="3" @bind-Value="_sendBody" /></div>
                </div>
            </CardContent>
            <CardFooter>
                <Button Disabled="_isSending" IsLoading="_isSending" data-testid="notification-send" OnClick="PrepareSendAsync">Gönder</Button>
            </CardFooter>
        </Card>
    </TabsContent>

    <TabsContent Value="history">
        <Card Class="table-card">
            @if (_history is { Count: 0 })
            {
                <EmptyState Title="Henüz manuel gönderim yok" Description="Panelden gönderilen duyurular burada listelenir." />
            }
            else if (_history is not null)
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Zaman</TableHead>
                            <TableHead>Gönderen</TableHead>
                            <TableHead>Hedef</TableHead>
                            <TableHead>Başlık</TableHead>
                            <TableHead Class="text-right">Alıcı</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var entry in _history)
                        {
                            var summary = ReadSendSummary(entry.NewValue);
                            <TableRow>
                                <TableCell Class="text-muted-foreground">@entry.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</TableCell>
                                <TableCell>@(entry.AdminDisplayName ?? "—")</TableCell>
                                <TableCell Class="font-mono text-xs">@entry.EntityId</TableCell>
                                <TableCell Class="max-w-sm">@summary.Title</TableCell>
                                <TableCell Class="text-right">@summary.RecipientCount</TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
                <Pager Meta="_historyMeta" OnPageChanged="LoadHistoryAsync" />
            }
        </Card>
    </TabsContent>
</Tabs>

<ConfirmDialog Open="_isSendConfirmOpen"
               OpenChanged="value => _isSendConfirmOpen = value"
               Title="Bildirimi gönder"
               Description="@SendConfirmDescription"
               ConfirmLabel="Gönder"
               OnConfirm="SendConfirmedAsync" />

@code {
    private const string TargetTypeSegment = "segment";
    private const string TargetTypeUser = "user";

    private IReadOnlyList<AdminNotificationTemplateDto>? _templates;
    private string? _editingType;
    private string _editTitle = string.Empty;
    private string _editBody = string.Empty;
    private string? _editHtmlBody;
    private bool _editInApp;
    private bool _editPush;
    private bool _editEmail;
    private bool _editActive;

    private string _targetType = TargetTypeSegment;
    private string _segmentRole = "client";
    private string _segmentCity = string.Empty;
    private string _targetUserId = string.Empty;
    private string _sendTitle = string.Empty;
    private string _sendBody = string.Empty;
    private bool _isSending;
    private bool _isSendConfirmOpen;
    private AdminSendNotificationDto? _pendingSend;
    private int _pendingRecipientCount;

    private const int HistoryPerPage = 20;
    private IReadOnlyList<AdminAuditLogDto>? _history;
    private AdminPageMetaDto? _historyMeta;

    private string SendConfirmDescription =>
        $"Bu duyuru {_pendingRecipientCount} aktif kullanıcıya gönderilecek. Gönderim geri alınamaz ve denetim kaydına yazılır.";

    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _infoMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadHistoryAsync(1);
    }

    private async Task LoadHistoryAsync(int page)
    {
        var result = await AdminClient.ListAuditLogsAsync(
            new AdminAuditLogQueryDto(null, AuditActions.NotificationSend, null, null, null, null, page, HistoryPerPage),
            CancellationToken.None);
        _history = result.Value?.Data;
        _historyMeta = result.Value?.Meta;
        _errorMessage ??= result.ErrorMessage;
    }

    private static (string Title, int RecipientCount) ReadSendSummary(string? newValue)
    {
        if (string.IsNullOrWhiteSpace(newValue))
        {
            return ("—", 0);
        }

        try
        {
            using var document = JsonDocument.Parse(newValue);
            var root = document.RootElement;
            var title = root.TryGetProperty("title", out var titleElement) ? titleElement.GetString() ?? "—" : "—";
            var count = root.TryGetProperty("recipientCount", out var countElement) ? countElement.GetInt32() : 0;
            return (title, count);
        }
        catch (JsonException)
        {
            return ("—", 0);
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var result = await AdminClient.ListNotificationTemplatesAsync(CancellationToken.None);
            _templates = result.Value;
            _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string ChannelLabel(AdminNotificationTemplateDto template)
    {
        var channels = new List<string>();
        if (template.InAppEnabled)
        {
            channels.Add("in-app");
        }

        if (template.PushEnabled)
        {
            channels.Add("push");
        }

        if (template.EmailEnabled)
        {
            channels.Add("e-posta");
        }

        return channels.Count > 0 ? string.Join(", ", channels) : "—";
    }

    private void ToggleEdit(AdminNotificationTemplateDto template)
    {
        if (_editingType == template.Type)
        {
            _editingType = null;
            return;
        }

        _editingType = template.Type;
        _editTitle = template.Title;
        _editBody = template.Body;
        _editHtmlBody = template.HtmlBody;
        _editInApp = template.InAppEnabled;
        _editPush = template.PushEnabled;
        _editEmail = template.EmailEnabled;
        _editActive = template.IsActive;
    }

    private async Task SaveTemplateAsync(string type)
    {
        var updated = await AdminClient.UpdateNotificationTemplateAsync(
            type,
            new UpdateAdminNotificationTemplateDto(_editTitle, _editBody, _editHtmlBody, _editPush, _editEmail, _editInApp, _editActive),
            CancellationToken.None);

        if (!updated.Succeeded)
        {
            _errorMessage = updated.ErrorMessage;
            return;
        }

        _editingType = null;
        await LoadAsync();
    }

    private async Task PrepareSendAsync()
    {
        _errorMessage = null;
        _infoMessage = null;

        if (string.IsNullOrWhiteSpace(_sendTitle) || string.IsNullOrWhiteSpace(_sendBody))
        {
            _errorMessage = "Başlık ve mesaj zorunludur.";
            return;
        }

        Guid? userId = null;
        if (_targetType == TargetTypeUser)
        {
            if (!Guid.TryParse(_targetUserId, out var parsed))
            {
                _errorMessage = "Geçerli bir kullanıcı ID giriniz.";
                return;
            }

            userId = parsed;
        }

        _isSending = true;
        try
        {
            var request = new AdminSendNotificationDto(
                _targetType,
                userId,
                _targetType == TargetTypeSegment ? _segmentRole : null,
                _targetType == TargetTypeSegment && !string.IsNullOrWhiteSpace(_segmentCity) ? _segmentCity : null,
                null,
                _sendTitle,
                _sendBody);

            var preview = await AdminClient.PreviewNotificationAsync(request, CancellationToken.None);
            if (preview.Value is null)
            {
                _errorMessage = preview.ErrorMessage;
                return;
            }

            if (preview.Value.RecipientCount == 0)
            {
                _errorMessage = "Seçilen hedefte bildirim alabilecek aktif kullanıcı yok.";
                return;
            }

            _pendingSend = request;
            _pendingRecipientCount = preview.Value.RecipientCount;
            _isSendConfirmOpen = true;
        }
        finally
        {
            _isSending = false;
        }
    }

    private async Task SendConfirmedAsync()
    {
        if (_pendingSend is not { } request)
        {
            return;
        }

        _isSendConfirmOpen = false;
        _pendingSend = null;
        _isSending = true;
        try
        {
            var sent = await AdminClient.SendNotificationAsync(request, CancellationToken.None);
            if (!sent.Succeeded)
            {
                _errorMessage = sent.ErrorMessage;
                return;
            }

            _infoMessage = $"{sent.Value} kullanıcıya bildirim gönderildi.";
            _sendTitle = string.Empty;
            _sendBody = string.Empty;
            await LoadHistoryAsync(1);
        }
        finally
        {
            _isSending = false;
        }
    }
}
