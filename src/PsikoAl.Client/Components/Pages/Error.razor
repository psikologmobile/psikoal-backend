@page "/Error"
@layout PsikoAl.Client.Components.Layout.BareLayout
@using System.Diagnostics

<PageTitle>Hata — Psikosirius Admin</PageTitle>

<div class="auth-shell">
    <Card Class="auth-card">
        <CardHeader>
            <CardTitle>Bir hata oluştu</CardTitle>
            <CardDescription>İsteğiniz işlenirken beklenmeyen bir sorun çıktı.</CardDescription>
        </CardHeader>
        @if (ShowRequestId)
        {
            <CardContent>
                <p class="muted">İstek numarası</p>
                <code class="request-id">@RequestId</code>
            </CardContent>
        }
        <CardFooter>
            <a class="link-button" href="/">Panele dön</a>
        </CardFooter>
    </Card>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
