@page "/categories"
@inject IAdminClientService AdminClient

<PageTitle>Kategoriler — Psikosirius Admin</PageTitle>

<PageHeader Title="Kategoriler"
            Description="Uzmanlık alanlarının ve ilan filtrelerinin tek kaynağı — burada eklenen veya pasifleştirilen her kategori uygulamadaki uzmanlık seçimini doğrudan etkiler." />

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

<Card Class="mb-4">
    <CardHeader>
        <CardTitle>Yeni Kategori</CardTitle>
        <CardDescription>Tüm alanlar zorunludur.</CardDescription>
    </CardHeader>
    <CardContent>
        <div class="form-grid">
            <div class="field">
                <Label>Slug</Label>
                <Input data-testid="category-new-slug" Placeholder="anksiyete" @bind-Value="_newSlug" />
            </div>
            <div class="field">
                <Label>Ad</Label>
                <Input data-testid="category-new-name" Placeholder="Anksiyete ve Kaygı" @bind-Value="_newName" />
            </div>
            <div class="field">
                <Label>İkon (Lucide)</Label>
                <Input data-testid="category-new-icon" Placeholder="brain" @bind-Value="_newIcon" />
            </div>
            <div class="field">
                <Label>Blog etiketi</Label>
                <Input data-testid="category-new-blogtag" Placeholder="anksiyete" @bind-Value="_newBlogTag" />
            </div>
            <div class="field">
                <Label>Kısa özet</Label>
                <Input data-testid="category-new-summary" Placeholder="Tek cümlelik özet" @bind-Value="_newSummary" />
            </div>
            <div class="field">
                <Label>Açıklama</Label>
                <Input data-testid="category-new-description" Placeholder="Detaylı açıklama" @bind-Value="_newDescription" />
            </div>
        </div>
    </CardContent>
    <CardFooter>
        <Button data-testid="category-create-submit" Disabled="_isCreating" IsLoading="_isCreating" OnClick="CreateAsync">Ekle</Button>
    </CardFooter>
</Card>

<Card Class="table-card" data-testid="category-table">
    @if (_isLoading)
    {
        <LoadingSkeleton />
    }
    else if (_categories is { Count: 0 })
    {
        <EmptyState Title="Kategori yok" Description="Yukarıdaki formdan ilk kategoriyi ekleyebilirsiniz." />
    }
    else if (_categories is not null)
    {
        <Table>
            <TableHeader>
                <TableRow>
                    <TableHead>Sıra</TableHead>
                    <TableHead>Ad</TableHead>
                    <TableHead>Slug</TableHead>
                    <TableHead>Durum</TableHead>
                    <TableHead Class="text-right">İşlem</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var category in _categories)
                {
                    <TableRow data-testid="@($"category-row-{category.Slug}")">
                        <TableCell>@category.SortOrder</TableCell>
                        <TableCell>@category.Name</TableCell>
                        <TableCell Class="text-muted-foreground">@category.Slug</TableCell>
                        <TableCell>
                            <StatusChip Status="@(category.IsActive ? "active" : "frozen")"
                                        Label="@(category.IsActive ? "Aktif" : "Pasif")" />
                        </TableCell>
                        <TableCell Class="cell-actions">
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                    data-testid="@($"category-toggle-{category.Slug}")"
                                    OnClick="() => ToggleActiveAsync(category)">
                                @(category.IsActive ? "Pasifleştir" : "Aktifleştir")
                            </Button>
                        </TableCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
    }
</Card>

@code {
    private IReadOnlyList<AdminCategoryListItemDto>? _categories;
    private bool _isLoading = true;
    private bool _isCreating;
    private string? _errorMessage;

    private string _newSlug = string.Empty;
    private string _newName = string.Empty;
    private string _newIcon = string.Empty;
    private string _newSummary = string.Empty;
    private string _newDescription = string.Empty;
    private string _newBlogTag = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var result = await AdminClient.ListCategoriesAsync(CancellationToken.None);
            _categories = result.Value;
            _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSlug) || string.IsNullOrWhiteSpace(_newName)
            || string.IsNullOrWhiteSpace(_newIcon) || string.IsNullOrWhiteSpace(_newSummary)
            || string.IsNullOrWhiteSpace(_newDescription) || string.IsNullOrWhiteSpace(_newBlogTag))
        {
            _errorMessage = "Yeni kategori için tüm alanlar zorunludur.";
            return;
        }

        _isCreating = true;
        _errorMessage = null;
        try
        {
            var created = await AdminClient.CreateCategoryAsync(
                new CreateCategoryDto(_newSlug, _newName, _newIcon, _newSummary, _newDescription, _newBlogTag, null),
                CancellationToken.None);

            if (!created.Succeeded)
            {
                _errorMessage = created.ErrorMessage;
                return;
            }

            _newSlug = _newName = _newIcon = _newSummary = _newDescription = _newBlogTag = string.Empty;
            await LoadAsync();
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task ToggleActiveAsync(AdminCategoryListItemDto category)
    {
        var updated = await AdminClient.UpdateCategoryAsync(
            category.Id,
            new UpdateCategoryDto(null, null, null, null, null, null, !category.IsActive, null),
            CancellationToken.None);

        _errorMessage = updated.ErrorMessage;
        if (updated.Succeeded)
        {
            await LoadAsync();
        }
    }
}
