@page "/listings"
@inject IAdminClientService AdminClient

<PageTitle>İlanlar — Psikosirius Admin</PageTitle>

<PageHeader Title="İlan Onayları"
            Description="Onaylanmayan ilanlar uzman feed'ine düşmez. Red ve yeniden açma işlemleri sebep ister." />

<div class="toolbar">
    <Select Class="toolbar-select" @bind-Value="_status">
        <option value="PENDING_APPROVAL">Onay Bekleyen</option>
        <option value="OPEN">Yayında</option>
        <option value="MATCHED">Eşleşildi</option>
        <option value="CLOSED">Kapalı</option>
        <option value="EXPIRED">Süresi Doldu</option>
        <option value="REJECTED_BY_ADMIN">Reddedildi</option>
        <option value="">Tümü</option>
    </Select>
    <Button Disabled="_isLoading" OnClick="FilterAsync">Filtrele</Button>
</div>

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

<Card Class="table-card">
    @if (_isLoading)
    {
        <LoadingSkeleton />
    }
    else if (_listings is { Count: 0 })
    {
        <EmptyState Title="İlan bulunamadı" Description="Seçtiğiniz durumda ilan yok." />
    }
    else if (_listings is not null)
    {
        <Table>
            <TableHeader>
                <TableRow>
                    <TableHead>Danışan</TableHead>
                    <TableHead>Başlık</TableHead>
                    <TableHead>Bütçe</TableHead>
                    <TableHead>Durum</TableHead>
                    <TableHead>Kayıt</TableHead>
                    <TableHead Class="text-right">İşlem</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var listing in _listings)
                {
                    <TableRow>
                        <TableCell>
                            @listing.ClientFullName
                            <div class="muted">@listing.ClientEmail</div>
                        </TableCell>
                        <TableCell Class="max-w-sm">@listing.Title</TableCell>
                        <TableCell Class="text-muted-foreground">@listing.BudgetLabel</TableCell>
                        <TableCell><StatusChip Status="@listing.Status" /></TableCell>
                        <TableCell Class="text-muted-foreground">@listing.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</TableCell>
                        <TableCell Class="cell-actions">
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                    OnClick="() => ToggleDetailAsync(listing.Id)">
                                @(_openListingId == listing.Id ? "Kapat" : "İncele")
                            </Button>
                        </TableCell>
                    </TableRow>

                    @if (_openListingId == listing.Id && _detail is not null)
                    {
                        <TableRow>
                            <TableCell Class="detail-cell" colspan="6">
                                <div class="detail-panel">
                                    <dl class="detail-list">
                                        <dt>Açıklama</dt>
                                        <dd>@_detail.Description</dd>
                                        <dt>Uzmanlıklar</dt>
                                        <dd>@string.Join(", ", _detail.Specialization)</dd>
                                        <dt>Seans Tipi</dt>
                                        <dd>@_detail.PreferredSessionType</dd>
                                        <dt>Şehir</dt>
                                        <dd>@(_detail.City ?? "—")</dd>
                                        <dt>Bitiş</dt>
                                        <dd>@(_detail.ExpiresAt?.ToLocalTime().ToString("dd.MM.yyyy") ?? "—")</dd>
                                    </dl>

                                    @if (_detail.RejectionReason is not null)
                                    {
                                        <Alert Variant="AlertVariant.Destructive">
                                            <AlertDescription>Red sebebi: @_detail.RejectionReason</AlertDescription>
                                        </Alert>
                                    }

                                    <div class="detail-actions">
                                        @if (_detail.Status == ListingStatusPendingApproval)
                                        {
                                            <Button Size="ButtonSize.Sm" OnClick="() => ApproveAsync(listing.Id)">Onayla</Button>
                                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                                    OnClick="() => AskReason(listing.Id, ListingAction.Reject)">
                                                Reddet
                                            </Button>
                                        }
                                        @if (_detail.Status == ListingStatusOpen)
                                        {
                                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" data-testid="listing-close"
                                                    OnClick="() => AskClose(listing.Id)">
                                                İlanı Kapat
                                            </Button>
                                            <Input Class="w-24" Type="number" @bind-Value="_extendDays" />
                                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                                    OnClick="() => ExtendAsync(listing.Id)">
                                                Süre Uzat
                                            </Button>
                                        }
                                        @if (_detail.Status == ListingStatusExpired)
                                        {
                                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                                    OnClick="() => AskReason(listing.Id, ListingAction.Reopen)">
                                                Yeniden Aç (istisnai)
                                            </Button>
                                        }
                                    </div>
                                </div>
                            </TableCell>
                        </TableRow>
                    }
                }
            </TableBody>
        </Table>
        <Pager Meta="_meta" Disabled="_isLoading" OnPageChanged="GoToPageAsync" />
    }
</Card>

<ReasonDialog Open="_isReasonDialogOpen"
              OpenChanged="value => _isReasonDialogOpen = value"
              Title="@ReasonDialogTitle"
              Description="@ReasonDialogDescription"
              ReasonLabel="Sebep"
              ConfirmLabel="@ReasonDialogConfirmLabel"
              OnConfirm="ReasonConfirmedAsync" />

<ConfirmDialog Open="_isCloseDialogOpen"
               OpenChanged="value => _isCloseDialogOpen = value"
               Title="İlanı kapat"
               Description="İlan uzman akışından düşer ve yeni teklif alamaz. İşlem denetim kaydına yazılır."
               ConfirmLabel="İlanı Kapat"
               ConfirmVariant="ButtonVariant.Destructive"
               OnConfirm="CloseConfirmedAsync" />

@code {
    private const string ListingStatusPendingApproval = "PENDING_APPROVAL";
    private const string ListingStatusOpen = "OPEN";
    private const string ListingStatusExpired = "EXPIRED";

    private enum ListingAction
    {
        Reject,
        Reopen,
    }

    private const int PerPage = 25;

    private IReadOnlyList<AdminListingListItemDto>? _listings;
    private AdminPageMetaDto? _meta;
    private int _page = 1;
    private AdminListingDetailDto? _detail;
    private Guid? _openListingId;
    private string _status = "PENDING_APPROVAL";
    private string _extendDays = "7";
    private bool _isLoading = true;
    private string? _errorMessage;

    private bool _isCloseDialogOpen;
    private Guid? _pendingCloseListingId;
    private bool _isReasonDialogOpen;
    private Guid? _pendingListingId;
    private ListingAction _pendingAction;

    private string ReasonDialogTitle =>
        _pendingAction == ListingAction.Reject ? "İlanı reddet" : "İlanı yeniden aç";

    private string ReasonDialogDescription => _pendingAction == ListingAction.Reject
        ? "Red sebebi danışana bildirilir; ilan düzenlenip tekrar onaya gönderilebilir."
        : "Süresi dolmuş ilanı yeniden açmak istisnai bir işlemdir ve audit log'a yazılır.";

    private string ReasonDialogConfirmLabel =>
        _pendingAction == ListingAction.Reject ? "Reddet" : "Yeniden Aç";

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task FilterAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _openListingId = null;
        try
        {
            var result = await AdminClient.ListListingsAsync(
                new AdminListingListQueryDto(_status, _page, PerPage),
                CancellationToken.None);
            _listings = result.Value?.Data;
            _meta = result.Value?.Meta;
            _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleDetailAsync(Guid listingId)
    {
        if (_openListingId == listingId)
        {
            _openListingId = null;
            _detail = null;
            return;
        }

        _openListingId = listingId;
        var detailResult = await AdminClient.GetListingDetailAsync(listingId, CancellationToken.None);
        _detail = detailResult.Value;
        _errorMessage = detailResult.ErrorMessage;
    }

    private void AskReason(Guid listingId, ListingAction action)
    {
        _pendingListingId = listingId;
        _pendingAction = action;
        _isReasonDialogOpen = true;
    }

    private async Task ReasonConfirmedAsync(string reason)
    {
        if (_pendingListingId is not { } listingId)
        {
            return;
        }

        var action = _pendingAction;
        _pendingListingId = null;

        var result = action == ListingAction.Reject
            ? await AdminClient.RejectListingAsync(listingId, reason, CancellationToken.None)
            : await AdminClient.ReopenListingAsync(listingId, reason, CancellationToken.None);

        _errorMessage = result.ErrorMessage;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }

    private async Task ApproveAsync(Guid listingId)
    {
        var result = await AdminClient.ApproveListingAsync(listingId, CancellationToken.None);
        _errorMessage = result.ErrorMessage;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }

    private void AskClose(Guid listingId)
    {
        _pendingCloseListingId = listingId;
        _isCloseDialogOpen = true;
    }

    private async Task CloseConfirmedAsync()
    {
        if (_pendingCloseListingId is not { } listingId)
        {
            return;
        }

        _isCloseDialogOpen = false;
        _pendingCloseListingId = null;

        var result = await AdminClient.CloseListingAsync(listingId, CancellationToken.None);
        _errorMessage = result.ErrorMessage;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }

    private async Task ExtendAsync(Guid listingId)
    {
        if (!int.TryParse(_extendDays, out var days) || days < 1)
        {
            _errorMessage = "Süre uzatmak için 1 veya daha büyük bir gün sayısı girin.";
            return;
        }

        var result = await AdminClient.ExtendListingAsync(listingId, days, CancellationToken.None);
        _errorMessage = result.ErrorMessage;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }
}
